{
  "$comment": "Phase 0.2 — CSV schema for the Yard Audit Location Breakdown. Mirrors Jake's Kraft sheet 1:1: 42 columns, two header rows. generate-csv.ts emits groupHeaderRow, then columnHeaderRow, then one row per facility (archetype auto-assigned), then 3 blank rows, then the summary block. 'fill' marks where each value comes from: meta = facility metadata, derived = computed by assignArchetype(), satellite = vision pass, operational = not visible from imagery (left blank for our runs), blank = always-empty spacer column.",
  "source": "scripts/yard-audit/kraft-baseline.csv (Jake's Kraft Location Breakdown)",
  "columnCount": 42,
  "groupHeaderRow": ["", "", "", "", "", "", "", "", "", "Connectivity", "Shipment", "Shifts per", "Guards per", "DCs per", "", "", "", "Staging Area", "", "Driveway", "", "Backup", "Entry/Exit", "", "", "", "Fast Lane", "Dock Doors", "", "", "", "Drop Area", "", "", "", "Ship/Rcv", "Urban /", "Potential", "Multiple", "", "Remote", ""],
  "columnHeaderRow": ["Name", "Type", "Archetype", "Archetype Name", "", "WMS", "TMS", "YMS", "EBOL", "Available", "Volume", "Day", "Shift", "Shift", "Truck Gate?", "Guard Shack?", "Remote GS?", "Pre-Gate", "Post-Gate", "Long (3+)", "Short (1-2 trucks)", "Sensitive?", "Together", "Separate", "Entry Lanes", "Exit Lanes", "Opportunity?", "0-10", "10-25", "25-50", "50+", "0-10", "10-25", "25-50", "50+", "Separate?", "Rural", "Connectivity Issue?", "Facilities?", "Scale", "Drop Yard", ""],
  "columns": [
    { "index": 0, "key": "name", "header": "Name", "fill": "meta", "type": "string" },
    { "index": 1, "key": "type", "header": "Type", "fill": "meta", "type": "string" },
    { "index": 2, "key": "archetype", "header": "Archetype", "fill": "derived", "type": "string", "note": "#1-#10 from assignArchetype()" },
    { "index": 3, "key": "archetypeName", "header": "Archetype Name", "fill": "derived", "type": "string" },
    { "index": 4, "key": "_spacer", "header": "", "fill": "blank", "type": "blank", "note": "Always-empty spacer column in Jake's sheet" },
    { "index": 5, "key": "wms", "header": "WMS", "fill": "operational", "type": "string" },
    { "index": 6, "key": "tms", "header": "TMS", "fill": "operational", "type": "string" },
    { "index": 7, "key": "yms", "header": "YMS", "fill": "operational", "type": "string" },
    { "index": 8, "key": "ebol", "header": "EBOL", "fill": "operational", "type": "string" },
    { "index": 9, "key": "connectivityAvailable", "header": "Available", "fill": "operational", "type": "string" },
    { "index": 10, "key": "shipmentVolume", "header": "Volume", "fill": "operational", "type": "string" },
    { "index": 11, "key": "shiftsPerDay", "header": "Day", "fill": "operational", "type": "string" },
    { "index": 12, "key": "guardsPerShift", "header": "Shift", "fill": "operational", "type": "string" },
    { "index": 13, "key": "dcsPerShift", "header": "Shift", "fill": "operational", "type": "string" },
    { "index": 14, "key": "truckGate", "header": "Truck Gate?", "fill": "satellite", "type": "yesno" },
    { "index": 15, "key": "guardShack", "header": "Guard Shack?", "fill": "satellite", "type": "yesno" },
    { "index": 16, "key": "remoteGs", "header": "Remote GS?", "fill": "satellite", "type": "yesno" },
    { "index": 17, "key": "preGateStaging", "header": "Pre-Gate", "fill": "satellite", "type": "yesno" },
    { "index": 18, "key": "postGateStaging", "header": "Post-Gate", "fill": "satellite", "type": "yesno" },
    { "index": 19, "key": "drivewayLong", "header": "Long (3+)", "fill": "satellite", "type": "yesno" },
    { "index": 20, "key": "drivewayShort", "header": "Short (1-2 trucks)", "fill": "satellite", "type": "yesno" },
    { "index": 21, "key": "backupSensitive", "header": "Sensitive?", "fill": "satellite", "type": "yesno" },
    { "index": 22, "key": "entryExitTogether", "header": "Together", "fill": "satellite", "type": "yesno" },
    { "index": 23, "key": "entryExitSeparate", "header": "Separate", "fill": "satellite", "type": "yesno" },
    { "index": 24, "key": "entryLanes", "header": "Entry Lanes", "fill": "satellite", "type": "int" },
    { "index": 25, "key": "exitLanes", "header": "Exit Lanes", "fill": "satellite", "type": "int" },
    { "index": 26, "key": "fastLaneOpportunity", "header": "Opportunity?", "fill": "satellite", "type": "yesno" },
    { "index": 27, "key": "dock0_10", "header": "0-10", "fill": "satellite", "type": "band-cell", "band": "dockDoors", "value": "0-10" },
    { "index": 28, "key": "dock10_25", "header": "10-25", "fill": "satellite", "type": "band-cell", "band": "dockDoors", "value": "10-25" },
    { "index": 29, "key": "dock25_50", "header": "25-50", "fill": "satellite", "type": "band-cell", "band": "dockDoors", "value": "25-50" },
    { "index": 30, "key": "dock50plus", "header": "50+", "fill": "satellite", "type": "band-cell", "band": "dockDoors", "value": "50+" },
    { "index": 31, "key": "drop0_10", "header": "0-10", "fill": "satellite", "type": "band-cell", "band": "dropArea", "value": "0-10" },
    { "index": 32, "key": "drop10_25", "header": "10-25", "fill": "satellite", "type": "band-cell", "band": "dropArea", "value": "10-25" },
    { "index": 33, "key": "drop25_50", "header": "25-50", "fill": "satellite", "type": "band-cell", "band": "dropArea", "value": "25-50" },
    { "index": 34, "key": "drop50plus", "header": "50+", "fill": "satellite", "type": "band-cell", "band": "dropArea", "value": "50+" },
    { "index": 35, "key": "shipRcvSeparate", "header": "Separate?", "fill": "satellite", "type": "yesno" },
    { "index": 36, "key": "urbanRural", "header": "Rural", "fill": "satellite", "type": "enum", "values": ["Urban", "Rural"] },
    { "index": 37, "key": "connectivityIssue", "header": "Connectivity Issue?", "fill": "satellite", "type": "yesno", "note": "Inferred: rural + isolated. Flag medium-confidence." },
    { "index": 38, "key": "multipleFacilities", "header": "Facilities?", "fill": "satellite", "type": "yesno" },
    { "index": 39, "key": "scale", "header": "Scale", "fill": "satellite", "type": "yesno" },
    { "index": 40, "key": "dropYard", "header": "Drop Yard", "fill": "satellite", "type": "yesno" },
    { "index": 41, "key": "url", "header": "", "fill": "meta", "type": "url", "note": "Google Maps URL. Jake's group-header row has a stray 'Remote' label above column 40; the column itself has no header in row 2." }
  ],
  "summaryBlock": {
    "$comment": "Appended after the data rows + 3 blank rows. Each summary row places its label in column 1, count in column 2, percent in column 3 (matching Jake's layout). generate-csv.ts computes the figures via summaryBlock().",
    "sections": [
      { "name": "Archetype distribution", "rows": "#1..#10 then Total", "metric": "assignArchetype() result" },
      { "name": "Fast Lane Opportunity", "metric": "classification.fastLaneOpportunity === true" },
      { "name": "Rural / connectivity", "metric": "classification.urbanRural === 'Rural'" },
      { "name": "Guarded / Not-Guarded", "metric": "classification.guardShack === true" },
      { "name": "# Shifts", "rows": "1, 2, 3, NA then Total", "metric": "operational.shiftsPerDay", "note": "Operational data — blank/NA for satellite-only runs" }
    ]
  }
}
