# YNS demo-pack satellite tiles — regenerable via
# `npx tsx scripts/yard-audit/build-all-packs.ts --tiles`
# ~484 MB across 1.6k JPEGs at 300KB each; too big for git.
# Pack JSONs (under the same dir) DO commit; only the tile binaries are excluded.
public/demo-packs/tiles/

# Prospect-discovery pipeline artifacts — regenerated by the scanner + scorer
# (`places-scanner.ts` -> `score-and-rank.ts`). Large, dated, reproducible;
# committing them risks a `git reset --hard` clobbering a fresh local scan.
# A stable SAMPLE-scored-prospects.json is committed for UI development.
output/prospect-discovery/corridor-scan-*.json
output/prospect-discovery/scored-prospects-*.json
output/prospect-discovery/scored-prospects-*.csv

# Local scratch dir — saved HTTP responses, probe images, batch logs.
# Tailwind 4 scans the project for class names; saved HTML in here can
# emit malformed CSS (e.g. error responses containing __next_f streaming
# buffers parsed as arbitrary-value classes). Keep out of source scan.
tmp/

.vercel
