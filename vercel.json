{
  "buildCommand": "npm run validate:packs && node scripts/check-force-dynamic.js && prisma generate && next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/check-inbox/",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-hubspot/",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/drip-sequence/",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/reenrich-contacts/",
      "schedule": "0 */8 * * *"
    },
    {
      "path": "/api/cron/dispatch-daily/",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/cron/qualification/",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/warm-dispatch/",
      "schedule": "15 12 * * 1-5"
    },
    {
      "path": "/api/cron/pounce-scan/",
      "schedule": "5 13 * * *"
    },
    {
      "path": "/api/cron/refresh-intel/",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/gap-mailbox/?mode=apply",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/gap-background-research/",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/cron/gap-signal-process/",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/gap-signal-discovery/",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/cron/gap-hubspot-replies/?mode=apply",
      "schedule": "45 12 * * *"
    },
    {
      "path": "/api/cron/gap-routing/",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/cron/gap-briefing/",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/gap-agent-tasks/",
      "schedule": "*/5 * * * *"
    }
  ]
}
